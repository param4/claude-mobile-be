# Copy to .env and adjust. Every variable is optional.

# Address to listen on. Default: this Mac's Tailscale IP (100.x.y.z), else 127.0.0.1.
# CM_HOST=100.x.y.z
# CM_PORT=8787

# Where the pairing token is kept (created on first run, mode 600).
# CM_CONFIG_DIR=~/.claude-mobile

# Claude desktop app session records and Claude Code transcripts.
# CM_DESKTOP_SESSIONS_DIR=~/Library/Application Support/Claude/claude-code-sessions
# CM_TRANSCRIPTS_DIR=~/.claude/projects

# Only for previewing the app in a web browser during development (enables CORS for that origin).
# CM_DEV_CORS_ORIGIN=http://localhost:8081
